{
  "name": "botlogik-app",
  "version": "1.0.9",
  "description": "BotLogik desktop app",
  "main": "out/main/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "test": "node --test tests/*.test.js",
    "test:workspace": "npm run build && env -u ELECTRON_RUN_AS_NODE electron tests/workspace-smoke.cjs",
    "build:icon": "node scripts/generate-mac-icon.cjs",
    "dist": "npm run build:icon && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "dist:mac": "npm run dist --",
    "dist:dmg": "npm run dist --",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/fix-node-pty-spawn-helper.cjs",
    "test:openrouter": "npm run build && env -u ELECTRON_RUN_AS_NODE electron tests/openrouter-smoke.cjs"
  },
  "build": {
    "appId": "com.botlogik.community",
    "productName": "BotLogik Community",
    "forceCodeSigning": false,
    "publish": null,
    "artifactName": "BotLogik-Community-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "identity": null,
      "hardenedRuntime": false,
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "icon": "build/icon.icns"
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.9",
    "lucide": "^0.468.0",
    "marked": "^18.1.1",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^5.4.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  },
  "license": "MIT",
  "botlogikOfficialUpdates": false
}
